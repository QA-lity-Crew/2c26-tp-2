              },
              {
                "name": "http503",
                "data_source": "metrics",
                "query": "sum:artillery.http.codes.503{test:arca-retry,$policy,$nodes} by {policy}.as_rate()"
              }
            ],
            "formulas": [
              {
                "formula": "http200"
              },
              {
                "formula": "http422"
              },
              {
                "formula": "http500"
              },
              {
                "formula": "http502"
              },
              {
                "formula": "http503"
              }
            ],
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            },
            "display_type": "line"
          }
