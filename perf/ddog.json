    {
      "definition": {
        "type": "timeseries",
        "title": "Motivo de finalizacion de validaciones/s",
        "title_size": "16",
        "title_align": "left",
        "description": "completed incluye aprobacion o rechazo fiscal. attempt_limit agota intentos; time_budget impide continuar por falta de margen; disabled es el control.",
        "show_legend": true,
        "legend_layout": "auto",
        "legend_columns": [
