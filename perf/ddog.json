        "type": "timeseries",
        "title": "Validacion completa mediana y p95 local (ms)",
        "title_size": "16",
        "title_align": "left",
        "description": "Incluye backoff y todos los intentos. Percentiles por host/ventana del agente, no p95 global de la corrida.",
        "show_legend": true,
        "legend_layout": "auto",
        "legend_columns": [
