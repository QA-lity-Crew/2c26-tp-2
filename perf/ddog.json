    {
      "definition": {
        "type": "timeseries",
        "title": "Recuperacion entre primeros fallos elegibles (%)",
        "title_size": "16",
        "title_align": "left",
        "description": "Elegible significa primer HTTP 500/502/503/504, no recuperabilidad probada. Incluye recuperaciones con rechazo fiscal. Sin elegibles el porcentaje no esta definido.",
        "show_legend": true,
        "legend_layout": "auto",
        "legend_columns": [
          "avg",
          "max",
          "value"
        ],
        "requests": [
          {
            "response_format": "timeseries",
            "queries": [
              {
                "name": "recuperadas",
                "data_source": "metrics",
                "query": "sum:arca.operation.recovered{$host,$policy} by {policy}.as_count()"
              },
              {
                "name": "elegibles",
                "data_source": "metrics",
                "query": "sum:arca.operation.retry_eligible{$host,$policy} by {policy}.as_count()"
              }
            ],
            "formulas": [
              {
                "formula": "100 * recuperadas / elegibles",
                "alias": "Validaciones recuperadas / elegibles %"
              }
            ],
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            },
            "display_type": "line"
          }
        ],
        "yaxis": {
          "min": "0",
          "include_zero": true,
          "scale": "linear"
        }
      },
      "layout": {
        "x": 0,
        "y": 24,
        "width": 6,
        "height": 3
      }
    },
    {
      "definition": {
