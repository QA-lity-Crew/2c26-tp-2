    {
      "definition": {
        "type": "timeseries",
        "title": "Artillery respuestas por codigo/s",
        "title_size": "16",
        "title_align": "left",
        "description": "422 es rechazo fiscal; 502 fallo remoto; 503 rechazo local. El reporte JSON es la fuente de totales.",
        "show_legend": true,
        "legend_layout": "auto",
        "legend_columns": [
          "avg",
          "max",
          "value"
        ],
        "requests": [
          {
            "response_format": "timeseries",
            "queries": [
              {
                "name": "http200",
                "data_source": "metrics",
                "query": "sum:artillery.http.codes.200{test:arca-retry,$policy,$nodes} by {policy}.as_rate()"
              },
              {
                "name": "http422",
                "data_source": "metrics",
                "query": "sum:artillery.http.codes.422{test:arca-retry,$policy,$nodes} by {policy}.as_rate()"
              },
              {
                "name": "http500",
